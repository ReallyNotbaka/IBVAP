# IBVAP Environment Configuration Example
# Copy this file to .env: cp .env.example .env

# Database Configuration:
# For offline / local development (no PostgreSQL or Docker required):
IBVAP_DB__URL=sqlite+aiosqlite:///data/ibvap.db

# For production / PostgreSQL:
# IBVAP_DB__URL=postgresql+asyncpg://ibvap:ibvap@localhost:5432/ibvap

# Biometrics & Privacy Gate:
# Set to 1 to enable facial recognition matching against watchlists
IBVAP_APP__ENABLE_FACE_IDENTITY=0

# Server host and port:
IBVAP_APP__HOST=0.0.0.0
IBVAP_APP__PORT=8000
IBVAP_APP__LOG_LEVEL=INFO

# MediaMTX Gateway URL:
IBVAP_MEDIA__MEDIAMTX_API_URL=http://localhost:9997
