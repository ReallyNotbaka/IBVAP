# IBVAP Local & Edge Runtime Configuration
IBVAP_API_TOKEN=ibvap-local-dev-token
VITE_IBVAP_API_TOKEN=ibvap-local-dev-token
IBVAP_CREDENTIAL_KEY=ibvap-local-dev-credential-key-32b

# Database (SQLite WAL mode by default for local/edge; use postgresql+asyncpg:// for Postgres)
IBVAP_DB__URL=sqlite+aiosqlite:///data/ibvap.db
IBVAP_DB__ALLOW_SQLITE_FALLBACK=1
