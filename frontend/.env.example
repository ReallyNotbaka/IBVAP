# Frontend (Vite) environment — copy to frontend/.env for local dev.
# VITE_API_BASE: same-origin proxy prefix (empty = relative /api calls via vite proxy).
VITE_API_BASE=
# REQUIRED for all mutating UI actions (POST/PUT/PATCH/DELETE send it as X-API-Token).
# Must match the backend IBVAP_API_TOKEN value or the API returns 401.
VITE_IBVAP_API_TOKEN=change-me-to-a-long-random-secret
